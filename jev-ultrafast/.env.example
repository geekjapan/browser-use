# azure (default) or openai; decision and text-helper credentials are independent.
DECISION_PROVIDER=azure
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna

AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DEPLOYMENT_NAME=decision-1
# Use an API key, or leave it empty and supply a current Entra token below.
AZURE_API_KEY=
AZURE_ENTRA_TOKEN=
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
